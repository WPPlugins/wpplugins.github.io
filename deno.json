{
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "tasks": {
    "index": "deno run --allow-net --allow-read --allow-write --allow-env scripts/build-index.ts",
    "build": "deno run --allow-read --allow-write scripts/build-site.ts",
    "check": "deno check scripts/**/*.ts",
    "test": "deno test --allow-read --allow-write tests/"
  }
}
